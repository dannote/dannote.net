---
# Three lines of Lean, marked up by hand: Lumis has no Lean parser.
lines = [
  [
    {:keyword, "def"},
    " ",
    {:function, "double"},
    " (n ",
    {:operator, ":"},
    " ",
    {:type, "Nat"},
    ") ",
    {:operator, ":"},
    " ",
    {:type, "Nat"},
    " ",
    {:operator, ":="},
    " ",
    {:operator, "2"},
    " ",
    {:operator, "*"},
    " n              ",
    {:comment, "-- a definition"}
  ],
  [
    {:keyword, "theorem"},
    " ",
    {:function, "double_even"},
    " (n ",
    {:operator, ":"},
    " ",
    {:type, "Nat"},
    ") ",
    {:operator, ":"},
    " ",
    {:operator, "2"},
    " ",
    {:operator, "∣"},
    " ",
    {:function, "double"},
    " n ",
    {:operator, ":="},
    "  ",
    {:comment, "-- a claim about it"}
  ],
  [
    "  ⟨n, ",
    {:function, "rfl"},
    "⟩                                       ",
    {:comment, "-- its proof, checked by the kernel"}
  ]
]

assigns = assign(assigns, :lines, lines)
---
<.article_code_pane lang="lean" lines={@lines} />
