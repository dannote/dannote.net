---
# One template in three forms: the Vue source, the LiveView Rendered struct that
# PhoenixVapor compiles it to, and what the socket carries. Colors follow the parts,
# not the syntax: statics gray, each dynamic slot its own color, across all panes.
static = :comment
name = :function
count = :operator
key = :type

template = [
  [
    {static, "<p>Hi, "},
    {name, "{{ name }}"},
    {static, ". You have "},
    {count, "{{ count }}"},
    {static, " new messages.</p>"}
  ]
]

compiled = [
  ["%Phoenix.LiveView.Rendered{"],
  ["  ", {key, "static:"}, " [", {static, ~s("<p>Hi, ")}, ", ", {static, ~s(". You have ")}, ","],
  ["           ", {static, ~s(" new messages.</p>")}, "],"],
  ["  ", {key, "dynamic:"}, " [", {name, "name"}, ", ", {count, "count"}, "]"],
  ["}"]
]

wire = [
  [{static, "// first render"}],
  ["{", {key, ~s("s")}, ": [", {static, ~s("<p>Hi, ")}, ", ", {static, ~s(". You have ")}, ","],
  ["       ", {static, ~s(" new messages.</p>")}, "],"],
  [
    " ",
    {name, ~s("0")},
    ": ",
    {name, ~s("Danila")},
    ", ",
    {count, ~s("1")},
    ": ",
    {count, ~s("3")},
    "}"
  ],
  [""],
  [{static, "// count changed"}],
  ["{", {count, ~s("1")}, ": ", {count, ~s("4")}, "}"]
]

assigns =
  assigns
  |> assign(:template, template)
  |> assign(:compiled, compiled)
  |> assign(:wire, wire)
  |> assign(:pane, "overflow-x-auto p-4 text-sm leading-6")
---
<.article_figure
  id="vapor-wire"
  caption="A Vue template, what PhoenixVapor compiles it to, and what the socket sends: the first render, then one changed value."
>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="min-w-0 sm:col-span-2">
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">Template</div>
      <.article_code_pane lang="vue" lines={@template} class={@pane} />
    </div>
    <div class="min-w-0">
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">Compiled</div>
      <.article_code_pane lang="elixir" lines={@compiled} class={@pane} />
    </div>
    <div class="min-w-0">
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">On the wire</div>
      <.article_code_pane lang="json" lines={@wire} class={@pane} />
    </div>
  </div>
</.article_figure>
