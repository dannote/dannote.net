---
# A code block that looks like a Lumis one, for markup made by hand. `lines` is a
# list of lines, each a list of plain strings and `{token, text}` segments, rendered
# by Blog.Highlight. `lang` sets the code element's language class and `class` adds
# sizing or spacing to the pre.
alias Blog.Highlight

assigns =
  assigns
  |> assign_new(:class, fn -> nil end)
  |> assign(:code, Highlight.render(assigns.lines))
  |> assign(:pane_class, Highlight.pane_class())
  |> assign(:pane_style, Highlight.pane_style())
---
<pre class={[@pane_class, @class]} style={@pane_style}><code class={"language-#{@lang}"} translate="no" tabindex="0">{@code}</code></pre>
