---
# Two drawings of the same card and what figma-use's visual diff makes of them.
# The images are generated by scripts/design_diff.exs with Skia and Image.
---
<figure class="not-prose my-10 border-y border-copy/25 py-6" aria-labelledby="design-diff-caption">
  <figcaption id="design-diff-caption" class="mb-5 text-sm text-dim">
    What the agent sees after a change: before, after, and the pixels that differ.
  </figcaption>
  <div class="grid gap-4 sm:grid-cols-3">
    <div>
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">Before</div>
      <.image
        src="images/figma/diff-before.png"
        alt="A card with a title, a timestamp, a line of text, and a blue Reply button."
        width={480}
        height={300}
        class="h-auto w-full border border-rule"
      />
    </div>
    <div>
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">After</div>
      <.image
        src="images/figma/diff-after.png"
        alt="The same card with a gray surface, the title renamed to v2, and a rounder, darker button."
        width={480}
        height={300}
        class="h-auto w-full border border-rule"
      />
    </div>
    <div>
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">Diff</div>
      <.image
        src="images/figma/diff-result.png"
        alt="The card with the changed pixels painted red: the v2 suffix and the button's edges."
        width={480}
        height={300}
        class="h-auto w-full border border-rule"
      />
    </div>
  </div>
</figure>
