---
# Two drawings of the same card, what figma-use's visual diff makes of them, and the
# same change as the patch an agent reads and applies. The images come from
# scripts/design_diff.exs; the patch is marked up by hand in diff colors.
add = "color: light-dark(#116329, #7ee787);"
del = "color: light-dark(#cf222e, #ff7b72);"
head = "color: light-dark(#57606a, #8b949e);"
pane = "lumis lumis-themes dark light overflow-x-auto px-3 py-2 text-xs leading-5"
theme = "color: light-dark(#1f2328, #e6edf3); background-color: light-dark(#ffffff, #0d1117);"

assigns =
  assigns
  |> assign(:add, add)
  |> assign(:del, del)
  |> assign(:head, head)
  |> assign(:pane, pane)
  |> assign(:theme, theme)
---
<figure class="not-prose my-10 border-y border-copy/25 py-6" aria-labelledby="design-diff-caption">
  <figcaption id="design-diff-caption" class="mb-5 text-sm text-dim">
    What the agent sees after a change: before, after, the pixels that differ, and the same change as a patch.
  </figcaption>
  <div class="grid gap-4 sm:grid-cols-3">
    <div>
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">Before</div>
      <.image
        src="images/figma/diff-before.png"
        alt="A card with a title, a timestamp, a line of text, and a blue Reply button."
        width={480}
        height={300}
        class="h-auto w-full border border-rule"
      />
    </div>
    <div>
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">After</div>
      <.image
        src="images/figma/diff-after.png"
        alt="The same card with a gray surface, the title renamed to v2, and a rounder, darker button."
        width={480}
        height={300}
        class="h-auto w-full border border-rule"
      />
    </div>
    <div>
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">Diff</div>
      <.image
        src="images/figma/diff-result.png"
        alt="The card with the changed pixels painted red: the v2 suffix and the button's edges."
        width={480}
        height={300}
        class="h-auto w-full border border-rule"
      />
    </div>
    <div class="sm:col-span-3">
      <div class="mb-2 text-xs uppercase tracking-wider text-dim">Patch</div>
      <div class="grid gap-4 sm:grid-cols-3">
        <pre class={@pane} style={@theme}><code class="language-diff" translate="no"><span style={@head}>--- /Card #1:23
+++ /Card #1:23</span>
 type: FRAME
 size: 400 236
<span style={@del}>-fill: #FFFFFF</span>
<span style={@add}>+fill: #F0F0F0</span></code></pre>
        <pre class={@pane} style={@theme}><code class="language-diff" translate="no"><span style={@head}>--- /Card/Title #1:24
+++ /Card/Title #1:24</span>
 type: TEXT
 font: Inter Bold 22
<span style={@del}>-text: "Card / Header"</span>
<span style={@add}>+text: "Card / Header v2"</span></code></pre>
        <pre class={@pane} style={@theme}><code class="language-diff" translate="no"><span style={@head}>--- /Card/Button #1:27
+++ /Card/Button #1:27</span>
 type: FRAME
 size: 132 40
<span style={@del}>-fill: #2563EB
-radius: 8</span>
<span style={@add}>+fill: #1D4ED8
+radius: 20</span></code></pre>
      </div>
    </div>
  </div>
</figure>
