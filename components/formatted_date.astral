---
lang = assigns[:lang] || "en"
value = assigns[:value]

format =
  case {lang, assigns[:short]} do
    {"ru", true} -> "%m.%Y"
    {"ru", _} -> "%d.%m.%Y"
    {_, true} -> "%b %Y"
    _ -> "%-d %B %Y"
  end

formatted =
  cond do
    match?(%Date{}, value) -> Calendar.strftime(value, format)
    is_binary(value) -> value
    true -> ""
  end

iso = if match?(%Date{}, value), do: Date.to_iso8601(value), else: formatted

assigns = assigns |> assign(:formatted, formatted) |> assign(:iso, iso)
---
<time datetime={@iso}>{@formatted}</time>
