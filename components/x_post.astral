---
label =
  case assigns[:kind] do
    "reply" -> "In reply to"
    "quote" -> "Quoting"
    _ -> "Context"
  end

assigns =
  assigns
  |> assign(:label, label)
  |> assign(:date, Date.from_iso8601!(assigns.date))
---
<figure class="not-prose my-6 border border-rule px-4 py-3 text-sm">
  <figcaption class="flex flex-wrap items-center gap-x-1.5 text-dim">
    <span>{@label}</span>
    <.icon name="simple-icons:x" class="size-3.5 shrink-0" aria-hidden="true" />
    <span class="text-copy">{@name}</span>
    <span>@{@handle}</span>
    <span aria-hidden="true">·</span>
    <a href={@url} class="text-dim no-underline hover:text-copy"><.formatted_date value={@date} /></a>
  </figcaption>
  <blockquote class="mt-2 whitespace-pre-line text-dim">{render_slot(@inner_block)}</blockquote>
</figure>
