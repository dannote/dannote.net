---
assigns = assign_new(assigns, :class, fn -> nil end)
---
<div class={[
  "prose prose-swiss max-w-none text-copy prose-headings:font-medium prose-h1:text-display prose-h1:mb-5 prose-h2:text-section prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-lg prose-p:my-3 prose-ul:my-3 prose-ol:my-3 prose-li:prose-p:my-1.5",
  @class
]}>
  {render_slot(@inner_block)}
</div>
