---
current = assigns[:route] || "/"

section =
  cond do
    String.starts_with?(current, "/writing") -> :writing
    String.starts_with?(current, "/projects") -> :projects
    String.starts_with?(current, "/about") -> :about
    true -> :home
  end

assigns = assign(assigns, :section, section)
---

<header class="site-header mb-8 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-b border-copy/20 py-6">
  <a href="/" aria-label="Danila Poyarkov, home">dannote.net</a>

  <nav class="flex flex-wrap gap-x-5 gap-y-2 [&_[aria-current=page]]:font-semibold [&_[aria-current=page]]:text-copy" aria-label="Primary navigation">
    <a href="/writing/" aria-current={@section == :writing && "page"}>Writing</a>
    <a href="/projects/" aria-current={@section == :projects && "page"}>Projects</a>
    <a href="/about/" aria-current={@section == :about && "page"}>About</a>
  </nav>
</header>
