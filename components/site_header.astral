---
current = assigns[:route] || "/"

section =
  cond do
    String.starts_with?(current, "/writing") -> :writing
    String.starts_with?(current, "/projects") -> :projects
    String.starts_with?(current, "/about") -> :about
    true -> :home
  end

assigns = assign(assigns, :section, section)
---
<header class="site-header mb-8 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-b border-rule py-6">
  <.nav_link href="/" class="hidden sm:inline" aria-label={"#{Blog.Site.author()}, home"}>{Blog.Site.domain()}</.nav_link>

  <nav
    class="flex flex-wrap gap-x-5 gap-y-2"
    aria-label="Primary navigation"
  >
    <.nav_link href="/writing/" active={@section == :writing}>Writing</.nav_link>
    <.nav_link href="/projects/" active={@section == :projects}>Projects</.nav_link>
    <.nav_link href="/about/" active={@section == :about}>About</.nav_link>
    <button
      hidden
      data-theme-toggle
      type="button"
      aria-label="Switch theme"
      class="-m-2 cursor-pointer p-2 text-dim hover:text-copy"
    >
      <span data-theme-icon="light"><.icon
        name="lucide:sun"
        width="20"
        height="20"
        class="inline-block align-middle"
        aria-hidden="true"
      /></span>
      <span data-theme-icon="dark" hidden><.icon
        name="lucide:moon"
        width="20"
        height="20"
        class="inline-block align-middle"
        aria-hidden="true"
      /></span>
    </button>
  </nav>
</header>
