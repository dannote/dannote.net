---
assigns =
  assigns
  |> assign_new(:active, fn -> false end)
  |> assign_new(:icon, fn -> nil end)
  |> assign_new(:class, fn -> nil end)

colors =
  case assigns.active do
    true -> "text-copy no-underline"
    false -> "text-dim no-underline hover:text-copy"
  end

assigns = assign(assigns, :colors, colors)
---
<.icon_link
  href={@href}
  icon={@icon}
  aria-current={@active && "page"}
  class={[@colors, @class]}
  {assigns_to_attributes(assigns, [:href, :icon, :active, :class, :colors, :inner_block])}
>{render_slot(@inner_block)}</.icon_link>
