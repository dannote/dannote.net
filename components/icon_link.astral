---
assigns =
  assigns
  |> assign_new(:icon, fn -> nil end)
  |> assign_new(:class, fn -> nil end)
---
<a
  href={@href}
  class={[@icon && "inline-flex items-center gap-1.5", @class]}
  {assigns_to_attributes(assigns, [:href, :icon, :class, :inner_block])}
><.icon
  :if={@icon}
  name={@icon}
  class="size-4 shrink-0"
  aria-hidden="true"
/>{render_slot(@inner_block)}</a>
