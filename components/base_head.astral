---
title = assigns[:title] || Blog.Site.author()

description = assigns[:description] || Blog.Site.description()

route = assigns[:route] || "/"
canonical = Blog.Site.absolute_url(route)
locale = assigns[:locale] || "en"
type = assigns[:type] || "website"
image_path = Blog.SocialImages.path(if type == "article", do: route)
image_url = Blog.Site.absolute_url(image_path)
image_alt = if type == "article", do: title, else: "#{Blog.Site.author()} — #{Blog.Site.domain()}"

assigns =
  assigns
  |> assign(:canonical, canonical)
  |> assign(:description, description)
  |> assign(:locale, locale)
  |> assign(:title, title)
  |> assign(:type, type)
  |> assign(:image_url, image_url)
  |> assign(:image_alt, image_alt)
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<.dynamic_tag tag_name="script">
  {Phoenix.HTML.raw("""
  try {
    const theme = localStorage.getItem("theme");
    if (theme === "light" || theme === "dark") document.documentElement.style.colorScheme = theme;
  } catch {}
  """)}
</.dynamic_tag>
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f1e9" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171714" />
<link rel="canonical" href={@canonical} />
<link
  rel="alternate"
  type="application/atom+xml"
  title={Blog.Site.feed_title()}
  href="/feed.xml"
/>
<title>{@title}</title>
<meta name="description" content={@description} />
<meta property="og:type" content={@type} />
<meta property="og:url" content={@canonical} />
<meta property="og:title" content={@title} />
<meta property="og:description" content={@description} />
<meta property="og:locale" content={@locale} />
<meta property="og:site_name" content={Blog.Site.domain()} />
<meta property="og:image" content={@image_url} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={@image_alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={@title} />
<meta name="twitter:description" content={@description} />
<meta name="twitter:image" content={@image_url} />
<meta name="twitter:image:alt" content={@image_alt} />
