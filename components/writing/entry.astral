<div class="not-prose">
  <div class="flex items-baseline gap-3">
    <h3 class="m-0 min-w-0 text-base font-medium tracking-normal">
      <a href={@entry.route_path} class="no-underline hover:underline">{@entry.data.title}</a>
    </h3>
    <.leader />
    <small class="shrink-0 text-sm text-dim tabular-nums"><.formatted_date
      value={@entry.data.date}
      lang={@entry.data.language}
      short
    /></small>
  </div>
  <p class="mt-1 mb-0 text-dim">{@entry.data.description}</p>
</div>
