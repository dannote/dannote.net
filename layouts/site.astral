---
alias Blog.Site, as: SiteInfo
---
<!doctype html>
<html lang={@metadata["language"] || "en"}>
  <head>
    <Site.head
      title={if @page.title, do: "#{@page.title} — #{SiteInfo.author()}", else: SiteInfo.author()}
      description={@metadata["description"]}
      route={@route}
      locale={@metadata["language"] || "en"}
    />
    <link rel="stylesheet" href={Astral.asset_path(@site, "styles.css")} />
    <script type="module" src={Astral.asset_path(@site, "app.ts")}>
    </script>
  </head>
  <body data-route={@route}>
    <Site.shell route={@route}>
      <main id="content">
        <.prose>{render_slot(@inner_block)}</.prose>
      </main>
    </Site.shell>
  </body>
</html>
