<!doctype html>
<html lang={@metadata["language"] || "en"}>
  <head>
    <.base_head
      title={if @page.title, do: "#{@page.title} — Danila Poyarkov", else: "Danila Poyarkov"}
      description={@metadata["description"]}
      route={@route}
      locale={@metadata["language"] || "en"}
    />
    <link rel="stylesheet" href={Astral.asset_path(@site, "styles.css")} />
    <script type="module" src={Astral.asset_path(@site, "app.ts")}>
    </script>
  </head>
  <body data-route={@route}>
    <.site_shell route={@route}>
      <main id="content">
        <.prose>{@content}</.prose>
      </main>
    </.site_shell>
  </body>
</html>
