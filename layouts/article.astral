---
lang = @entry.data.language || "en"

assigns =
  assigns
  |> assign(:lang, lang)
  |> assign(:description, @entry.data.description)
  |> assign(:title, "#{@entry.data.title} — #{Blog.Site.author()}")
---
<!doctype html>
<html lang={@lang}>
  <head>
    <Site.head
      title={@title}
      description={@description}
      route={@route}
      locale={@lang}
      type="article"
    />
    <link rel="stylesheet" href={Astral.asset_path(@site, "styles.css")} />
    <script type="module" src={Astral.asset_path(@site, "app.ts")}>
    </script>
  </head>
  <body data-route={@route} data-entry-kind="article">
    <Site.shell route={@route} skip_target="article-content" skip_label="Skip to article">
      <main id="article-content">
        <article class="pb-6 wide:-ml-toc-offset wide:grid wide:grid-cols-article wide:gap-x-10">
          <header class="mb-6 wide:col-start-2">
            <h1 class="text-display">{@entry.data.title}</h1>
            <p
              :if={@entry.data[:subtitle]}
              class="mt-rhythm-2 max-w-3xl text-deck leading-snug tracking-tight pretty"
            >
              {@entry.data.subtitle}
            </p>
            <Article.meta entry={@entry} />
          </header>

          <Article.contents headings={@entry.content.headings} />
          <.prose class="wide:col-start-2">{render_slot(@inner_block)}</.prose>
        </article>
      </main>
    </Site.shell>
  </body>
</html>
