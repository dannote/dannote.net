---
lang = @entry.data.language || "en"

assigns =
  assigns
  |> assign(:lang, lang)
  |> assign(:description, @entry.data.description)
  |> assign(:title, "#{@entry.data.title} — Danila Poyarkov")
---

<!doctype html>
<html lang={@lang}>
  <head>
    <.base_head
      title={@title}
      description={@description}
      route={@route}
      locale={@lang}
      type="article"
    />
    <link rel="stylesheet" href={Astral.asset_path(@site, "styles.css")} />
    <script type="module" src={Astral.asset_path(@site, "app.ts")}></script>
  </head>
  <body data-route={@route} data-entry-kind="article">
    <a class="fixed top-3 left-3 z-100 -translate-y-[200%] bg-copy px-3 py-2 text-page focus:translate-y-0" href="#article-content">Skip to article</a>
    <div class="mx-auto w-[calc(100%-2.5rem)] max-w-6xl">
      <.site_header route={@route} />
      <main id="article-content" class="min-h-[62vh]">
        <article class="grid grid-cols-[14rem_minmax(0,1fr)] gap-x-10 pb-6 max-lg:grid-cols-1">
          <header class="col-start-2 max-w-5xl max-lg:col-start-1">
            <p class="text-sm"><a href="/writing/">Writing</a></p>
            <h1 class="mt-3 text-display">{@entry.data.title}</h1>
            <p class="mt-rhythm-2 max-w-3xl text-deck leading-[1.3] tracking-[-.02em] pretty">{@description}</p>
            <.entry_meta entry={@entry} kind="Essay" />
          </header>

          <aside :if={@entry.content.headings != []} class="article-toc col-start-1 row-start-2 mt-8 text-sm leading-relaxed max-lg:col-start-1 max-lg:row-auto" aria-labelledby="toc-title">
            <details open>
              <summary id="toc-title">Contents</summary>
              <ol>
                <li :for={heading <- @entry.content.headings} class={"toc-level-#{heading.level}"}>
                  <a href={"##{heading.id}"}>{heading.text}</a>
                </li>
              </ol>
            </details>
          </aside>

          <div class="prose prose-swiss col-start-2 mt-8 max-w-[68ch] text-copy max-lg:col-start-1">
            {@content}
          </div>
        </article>
      </main>
      <.site_footer />
    </div>
  </body>
</html>
