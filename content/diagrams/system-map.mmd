flowchart TB
    HYPOTHESIS["Product hypothesis"]

    subgraph DESIGN["Design and prototype"]
        direction LR
        OPENPENCIL["OpenPencil<br/>References, alternative drafts,<br/>structured .fig designs"]
        VUEPENCIL["VuePencil<br/>Interactive prototypes made<br/>from real Vue components"]
        OPENPENCIL --> VUEPENCIL
    end

    subgraph ENGINEERING["Build and verify"]
        direction TB
        WORK["Agent-assisted implementation"]

        subgraph AGENTS["Agent environment"]
            direction LR
            PI_ELIXIR["pi-elixir<br/>BEAM runtime and structural tools for Pi"]
            VIBE["Vibe<br/>Networked BEAM-native agents"]
            TILDE["Tilde<br/>Semantic agent sessions and interfaces"]
        end

        subgraph CHECKS["Verification"]
            direction LR
            EXAST["ExAST<br/>Structural search and rewriting"]
            EXDNA["ExDNA<br/>Duplicate implementation detection"]
            EXSLOP["ExSlop<br/>Generated-code checks"]
            REACH["Reach<br/>Execution graphs, data flow,<br/>effects, OTP, and architecture"]
            EXOGRAPH["Exograph<br/>Ecosystem-scale code search<br/>and rule validation"]
            VIBEKIT["VibeKit<br/>Repeatable project quality baseline"]
        end

        PI_ELIXIR --> WORK
        VIBE --> WORK
        TILDE --> WORK
        EXAST --> WORK
        EXDNA --> WORK
        EXSLOP --> WORK
        REACH --> WORK
        VIBEKIT --> WORK
        EXOGRAPH -. "validates rules across Hex.pm" .-> REACH
    end

    subgraph APPLICATION["Frontend and backend"]
        direction LR
        QUICKBEAM["QuickBEAM<br/>Supervised, observable, resource-bounded<br/>JavaScript execution inside the BEAM"]
        NPM["npm_ex<br/>npm packages from Elixir"]
        VOLT["Volt<br/>Frontend build, HMR,<br/>linting, and tests"]
        VAPOR["PhoenixVapor<br/>Vue templates compiled<br/>to LiveView structures"]
        PRODUCT["Working application"]

        QUICKBEAM --> VOLT
        NPM --> VOLT
        VOLT --> PRODUCT
        VAPOR --> PRODUCT
    end

    subgraph FOUNDATIONS["Shared data and services"]
        direction LR
        QUACKDB["QuackDB<br/>Portable application and<br/>analytical storage"]
        LLMPROXY["LLMProxy<br/>Model routing, quotas,<br/>traces, and costs"]
        EGRESS["Egress<br/>Typed access to external APIs"]
        SERVICES["Further building blocks<br/>Authentication, files, billing,<br/>notifications, and realtime"]
    end

    subgraph DELIVERY["Package and deploy"]
        direction LR
        RELEASEKIT["ReleaseKit<br/>Deployment-neutral OTP artifacts"]
        HOSTKIT["HostKit<br/>Observable host configuration,<br/>deployment, audit, and rollback"]
        LIVE["Running product"]
        RELEASEKIT --> HOSTKIT --> LIVE
    end

    subgraph OPERATION["Observe and operate"]
        direction LR
        ANALYTICS["Analytics<br/>Traffic, funnels, attribution,<br/>conversion, and revenue"]
        REPLAY["PhoenixReplay<br/>Frontend and backend<br/>session replay"]
        INCANT["Incant<br/>Unified investigation,<br/>administration, and control"]
        DECISION["Evidence-backed next step"]

        ANALYTICS --> INCANT
        REPLAY --> INCANT
        INCANT --> DECISION
    end

    HYPOTHESIS --> OPENPENCIL
    VUEPENCIL --> WORK
    WORK --> PRODUCT
    PRODUCT --> RELEASEKIT

    QUACKDB -. "storage" .-> PRODUCT
    LLMPROXY -. "models" .-> PRODUCT
    EGRESS -. "external operations" .-> PRODUCT
    SERVICES -. "application capabilities" .-> PRODUCT

    LIVE --> ANALYTICS
    LIVE --> REPLAY
    LIVE -. "OTP state and telemetry" .-> INCANT
    QUACKDB -. "shared data" .-> INCANT
    LLMPROXY -. "usage and cost" .-> INCANT
    EGRESS -. "campaigns and services" .-> INCANT
    HOSTKIT -. "infrastructure state" .-> INCANT

    DECISION --> HYPOTHESIS
